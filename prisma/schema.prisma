generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A single job posting scraped from a job site.
model Job {
  id          Int       @id @default(autoincrement())
  site        JobSite
  siteJobId   String    @map("site_job_id") @db.VarChar(191)
  title       String    @db.VarChar(512)
  description String    @db.LongText
  jobUrl      String    @map("job_url") @db.VarChar(1024)
  applyUrl    String?   @map("apply_url") @db.VarChar(2048)
  company     String?   @db.VarChar(255)
  companyUrl  String?   @map("company_url") @db.VarChar(1024)
  jobType     String?   @map("job_type") @db.VarChar(64)
  remote      Boolean   @default(false)
  location    String?   @db.VarChar(255)
  salary      String?   @db.VarChar(255)
  postedAt    DateTime? @map("posted_at")

  /// Content identity: sha1 of site, company, title, location and the first 100
  /// characters of the description, each normalised (NFKD, accents stripped,
  /// lower-cased, every run of non-alphanumerics collapsed to one space).
  ///
  /// `siteJobId` identifies a LISTING; this identifies the JOB. They are not the
  /// same thing: The Muse regenerates the hash in its URL slug on every render,
  /// and Glassdoor issues several listing ids for one posting, so keying only on
  /// the source id let the same job in five times. Normalisation is what makes
  /// it hold — two captures of that AppFolio posting differed by a single
  /// character, so an exact hash would have missed them.
  ///
  /// Company is part of the key even though it is not in the description prefix:
  /// without it, "Software Engineer (Full Stack)" in Lehi, UT collapsed two
  /// different employers into one row.
  fingerprint String? @db.Char(40)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resumes      Resume[]
  applications JobApplication[]
  discards     JobDiscard[]
  coverLetters CoverLetter[]
  interviews   Interview[]
  aiQueries    JobAiQuery[]

  @@unique([site, siteJobId], name: "site_siteJobId")
  /// The real duplicate guard. Nullable so a row whose fingerprint could not be
  /// computed still stores — MySQL treats NULLs as distinct, so those simply do
  /// not participate rather than colliding with each other.
  @@unique([site, fingerprint], name: "site_fingerprint")
  @@index([site])
  @@map("jobs")
}

enum JobSite {
  indeed
  glassdoor
  jobright
  weworkremotely
  himalayas
  findmyremote
  jobicy
  themuse
  linkedin
}

/// The scrapers' staging table. Structurally a copy of `jobs`, written by
/// job-seeking/scraper/db.py when a scraper sets `table = "jobs_temp"` (today:
/// scraper/remoteok.py, "Promote to jobs once verified"). Modelled here ONLY so
/// `prisma migrate diff` reports zero drift and `prisma migrate dev` stays
/// usable — the backend never reads or writes it.
///
/// Index names are mapped to the ones the live table actually carries: it was
/// created as a copy of `jobs`, so they are `jobs_site_*`, not `jobs_temp_*`.
model JobTemp {
  id          Int         @id @default(autoincrement())
  site        JobSiteTemp
  siteJobId   String      @map("site_job_id") @db.VarChar(191)
  title       String      @db.VarChar(512)
  description String      @db.LongText
  jobUrl      String      @map("job_url") @db.VarChar(1024)
  applyUrl    String?     @map("apply_url") @db.VarChar(2048)
  company     String?     @db.VarChar(255)
  companyUrl  String?     @map("company_url") @db.VarChar(1024)
  jobType     String?     @map("job_type") @db.VarChar(64)
  remote      Boolean     @default(false)
  location    String?     @db.VarChar(255)
  salary      String?     @db.VarChar(255)
  postedAt    DateTime?   @map("posted_at")

  /// Mirrors `Job.fingerprint` so the writer can target either table with one
  /// statement, and so a staged row is already de-duplicated before promotion.
  fingerprint String? @db.Char(40)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([site, siteJobId], map: "jobs_site_site_job_id_key")
  @@unique([site, fingerprint], map: "jobs_temp_site_fingerprint_key")
  @@index([site], map: "jobs_site_idx")
  @@map("jobs_temp")
}

/// Same as JobSite plus `remoteok`, which is staged in jobs_temp and is NOT yet
/// a legal value in the `jobs` enum. Promoting RemoteOK to `jobs` (flipping
/// `table` in scraper/remoteok.py) therefore needs its own migration adding
/// `remoteok` to JobSite first, or every insert fails.
enum JobSiteTemp {
  indeed
  glassdoor
  jobright
  weworkremotely
  remoteok
  himalayas
  findmyremote
  jobicy
  themuse
  linkedin
}

/// One scraper run — logged by the Python scrapers so super-admins can see when
/// each site last scraped, how long it took, and how many jobs it found.
model ScrapeRun {
  id         Int       @id @default(autoincrement())
  site       String    @db.VarChar(64) // indeed | glassdoor | jobright | weworkremotely | all
  status     String    @default("running") @db.VarChar(20) // running | success | failed
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  inserted   Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  skipped    Int       @default(0)
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@map("scrape_runs")
}

/// Scraper configuration, editable by super-admins (search/filter URLs, enable
/// flags, limits…). The Python scrapers read these and override their .env
/// defaults at startup. Simple key/value so new settings need no migration.
model ScraperSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_settings")
}

/// Persisted browser session cookies per site (google/indeed/glassdoor/…),
/// replacing the local sessions/*.json files so sessions live in the DB.
model ScraperSession {
  site      String   @id @db.VarChar(64)
  cookies   String   @db.LongText // JSON array of cookies
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_sessions")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(guest)
  createdAt    DateTime @default(now()) @map("created_at")

  profiles Profile[]

  /// Invitations addressed to this user (profiles others let them use).
  profileInvitations ProfileInvitation[] @relation("InvitationInvitee")
  /// Invitations this user sent out.
  sentInvitations    ProfileInvitation[] @relation("InvitationInviter")

  /// "Applied" marks this user put on a job. A shared profile has several
  /// users, so the marker records WHO, not just that someone did.
  applicationsMarked JobApplication[] @relation("ApplicationMarkedBy")

  /// "Discarded" marks this user put on a job, same reasoning as above:
  /// a shared profile has several users, so the row records WHO dismissed it.
  discardsMarked JobDiscard[] @relation("DiscardMarkedBy")

  /// Interview timelines this user opened, same reasoning as the two above:
  /// a shared profile has several users, so the row records WHO started it.
  interviewsOpened Interview[] @relation("InterviewOpenedBy")

  /// Questions this user asked the model about a posting.
  aiQueriesAsked JobAiQuery[] @relation("AiQueryAskedBy")

  /// Prompts this super admin last edited.
  promptsEdited Prompt[]

  /// Anthropic calls made on this user's behalf, for cost attribution.
  aiUsage AiUsage[]

  /// Prepaid balance in MICRO-USD — the same unit as `AiUsage.costMicroUsd`,
  /// so a generation's cost can be subtracted from it without conversion.
  /// USDT is treated as 1:1 with USD, which is what the deposit flow assumes.
  ///
  /// A CACHE, not the source of truth: it is only ever written alongside a
  /// `CreditEntry` in the same transaction, and the entries are what can be
  /// audited. Reading a single column keeps the top bar cheap; the ledger is
  /// what answers "why is it this number".
  balanceMicroUsd Int @default(0) @map("balance_micro_usd")

  /// Every movement of this user's balance.
  creditEntries CreditEntry[] @relation("CreditOwner")
  /// Credits this super admin granted to somebody.
  creditsGranted CreditEntry[] @relation("CreditCreatedBy")

  /// Deposits this user says they made.
  topUpRequests TopUpRequest[] @relation("TopUpRequester")
  /// Deposit claims this super admin ruled on.
  topUpsReviewed TopUpRequest[] @relation("TopUpReviewer")

  @@map("users")
}

/// The chains the deposit address accepts. Same address on both, which is why
/// the chain has to be recorded — it is the only way to know where to look the
/// transaction up.
enum CryptoChain {
  bep20
  erc20
}

enum TopUpStatus {
  pending
  credited
  rejected
}

/// A user's claim that they sent USDT to the deposit address.
///
/// A CLAIM, not a payment. Nothing here moves a balance on its own: a super
/// admin verifies the hash on-chain and decides what to credit. The amount the
/// user typed is kept separately from the amount actually granted, because the
/// two disagreeing is the normal case this flow exists to catch.
model TopUpRequest {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation("TopUpRequester", fields: [userId], references: [id], onDelete: Cascade)

  chain  CryptoChain
  /// The transaction hash as pasted. Kept verbatim — normalising case would
  /// make it harder to paste back into an explorer.
  txHash String @map("tx_hash") @db.VarChar(120)

  /// What the user says they sent, in micro-USD. Advisory only.
  claimedMicroUsd Int @map("claimed_micro_usd")

  status TopUpStatus @default(pending)

  /// What was actually granted. Null until a super admin rules on it, and
  /// deliberately allowed to differ from `claimedMicroUsd`.
  creditedMicroUsd Int? @map("credited_micro_usd")

  /// The user's note, then the reviewer's. Separate fields so a rejection
  /// reason cannot overwrite what the user originally said.
  note       String? @db.VarChar(500)
  reviewNote String? @map("review_note") @db.VarChar(500)

  reviewedById Int?      @map("reviewed_by_id")
  reviewedBy   User?     @relation("TopUpReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// One claim per transaction per chain. The same hash submitted twice is the
  /// obvious way to get paid twice, and the database is the only place that can
  /// refuse it reliably — two admins reviewing at once would both see "pending".
  @@unique([chain, txHash])
  @@index([status, createdAt])
  @@index([userId])
  @@map("top_up_requests")
}

enum CreditEntryKind {
  topup
  usage
  adjustment
}

/// One movement of one user's balance. Append-only.
///
/// Exists so a balance can always be explained. `balanceAfterMicroUsd` is
/// recorded at write time rather than recomputed, so a later correction cannot
/// silently rewrite the history of what the balance was when a call was made.
model CreditEntry {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation("CreditOwner", fields: [userId], references: [id], onDelete: Cascade)

  kind CreditEntryKind

  /// SIGNED micro-USD: positive credits, negative spends. Summing this column
  /// for a user must equal their `balanceMicroUsd`, and that is the invariant
  /// the reconcile script checks.
  amountMicroUsd Int @map("amount_micro_usd")

  balanceAfterMicroUsd Int @map("balance_after_micro_usd")

  note String? @db.VarChar(500)

  /// What caused it. Plain ints with no foreign key, same reasoning as
  /// `AiUsage.jobId`: the ledger must outlive whatever it refers to.
  aiUsageId      Int? @map("ai_usage_id")
  topUpRequestId Int? @map("top_up_request_id")

  /// The super admin who granted it, for credits that a person made happen.
  createdById Int?  @map("created_by_id")
  createdBy   User? @relation("CreditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_entries")
}

enum Role {
  super_admin
  admin
  bidder
  guest
}

/// A word to emphasize in job descriptions (managed by admins). The unique
/// constraint is case-insensitive via the utf8mb4_unicode_ci collation.
model Keyword {
  id        Int      @id @default(autoincrement())
  word      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keywords")
}

/// A candidate/bidding profile, owned by an admin. Holds personal info plus
/// repeatable work experience and education entries.
///
/// Two kinds of user reach a profile: its OWNER, who may edit and delete it,
/// and anyone holding an accepted `ProfileInvitation`, who may only read it and
/// generate resumes from it. Every query that serves a profile has to pick one
/// of those two scopes deliberately — see `ownedProfileWhere` /
/// `usableProfileWhere` in profile.service.ts.
model Profile {
  id      Int  @id @default(autoincrement())
  ownerId Int  @map("owner_id")
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  email     String? @db.VarChar(255)
  firstName String? @map("first_name") @db.VarChar(120)
  lastName  String? @map("last_name") @db.VarChar(120)
  phone     String? @db.VarChar(60)
  linkedin  String? @db.VarChar(512)
  location  String? @db.VarChar(255)

  /// Which template preset this profile's resumes render with. A plain key,
  /// not a relation: an archived or renamed preset must degrade to the default
  /// rather than break every resume that referenced it.
  defaultTemplateKey String? @map("default_template_key") @db.VarChar(64)


  workExperiences WorkExperience[]
  educations      Education[]
  resumes         Resume[]
  invitations     ProfileInvitation[]
  applications    JobApplication[]
  discards        JobDiscard[]
  coverLetters    CoverLetter[]
  interviews      Interview[]
  aiQueries       JobAiQuery[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("profiles")
}

/// An invitation from a profile's owner letting another user USE that profile:
/// see it on their own Profiles page and generate resumes from it, without ever
/// being able to edit its contents.
///
/// The invitation is a request, not a grant — access starts only once the
/// invitee sets it to `accepted`. Keeping `declined` as a stored state rather
/// than deleting the row is what lets the owner see the answer instead of
/// watching an invitation silently vanish and re-sending it forever.
model ProfileInvitation {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Who was invited.
  userId Int  @map("user_id")
  user   User @relation("InvitationInvitee", fields: [userId], references: [id], onDelete: Cascade)

  /// Who sent it. Normally the profile's owner, but recorded separately so the
  /// trail survives a future ownership transfer.
  invitedById Int  @map("invited_by_id")
  invitedBy   User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  status InvitationStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  /// One invitation per (profile, user): re-inviting reopens the existing row
  /// rather than stacking duplicates the owner would have to reconcile.
  @@unique([profileId, userId])
  @@index([userId, status])
  @@map("profile_invitations")
}

enum InvitationStatus {
  pending
  accepted
  declined
}

/// One work-experience entry on a profile. `endDate` null = "Present".
/// Dates are month-granularity (stored as the 1st of the month, no timezone).
model WorkExperience {
  id        Int     @id @default(autoincrement())
  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company   String?   @db.VarChar(255)
  location  String?   @db.VarChar(255)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  sortOrder Int       @default(0) @map("sort_order")

  @@index([profileId])
  @@map("work_experiences")
}

/// One education entry on a profile. `endDate` null = "Present".
model Education {
  id        Int     @id @default(autoincrement())
  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  university String?   @db.VarChar(255)
  location   String?   @db.VarChar(255)
  degree     String?   @db.VarChar(255)
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date

  /// How precise the dates above are: "year" or "month".
  ///
  /// Stored rather than inferred, because the column is a DATE and a year-only
  /// entry lands on YYYY-01-01 — which is indistinguishable from someone who
  /// genuinely started in January. Without this flag, "2012" and "January 2012"
  /// are the same row, and every render has to guess which the person meant.
  ///
  /// Defaults to "month" so the rows written before the choice existed keep
  /// reading the way they were entered; the editor offers "year" for new ones.
  datePrecision String @default("month") @map("date_precision") @db.VarChar(8)

  sortOrder Int @default(0) @map("sort_order")

  @@index([profileId])
  @@map("educations")
}

/// One AI-generated resume, tailored to one job posting for one profile.
///
/// `jobId` is NULLABLE with onDelete: SetNull, and the posting's title/company
/// are denormalised onto the row. That combination is deliberate:
///   - Cascade would let a routine job prune silently destroy work the user
///     paid model tokens for and may have already sent to an employer.
///   - Restrict would make `DELETE FROM jobs WHERE site='themuse'` fail, which
///     is exactly the re-scrape flow this project uses.
/// SetNull keeps deletes cheap AND keeps the resume readable afterwards, at the
/// cost of two duplicated columns.
///
/// Exactly one resume per (profile, job). Regenerating replaces the text in
/// place; there is no draft history, so nothing accumulates and there is never
/// a question of which version is current.
model Resume {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the resume still makes sense once its job row is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  /// The generated document, shaped by `tailoredResumeSchema`. Json rather than
  /// columns because the shape is still settling and nothing queries into it.
  data        Json
  templateKey String @default("classic-ats") @map("template_key") @db.VarChar(64)
  /// Which model produced it, so a later prompt change can find stale rows.
  model       String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("resumes")
}

/// "I applied to this posting" — one marker per (profile, job).
///
/// Scoped to a PROFILE rather than to a user or to the job itself, matching
/// `Resume`. Two bidders working different profiles apply to different jobs, so
/// a flag on `Job` would show one person's progress to everyone. A profile
/// shared with a team is the case that makes this load-bearing: everyone using
/// that profile must see the same applied state, or two of them apply to the
/// same posting under the same name.
///
/// `jobId` is NULLABLE with onDelete: SetNull and the posting's title/company
/// are denormalised onto the row, for the same reason `Resume` does it: the job
/// table is re-scraped and pruned routinely, and "I already applied here" is
/// user-entered history that a maintenance delete must not destroy. Re-applying
/// to a posting you already answered is exactly what this feature exists to
/// prevent.
model JobApplication {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the record still reads once its job row is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  /// When the application was marked. Editable later if someone back-dates it;
  /// distinct from createdAt, which is when the row appeared.
  appliedAt DateTime @default(now()) @map("applied_at")

  /// Which member of a shared profile marked it.
  markedById Int  @map("marked_by_id")
  markedBy   User @relation("ApplicationMarkedBy", fields: [markedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One marker per pairing: marking twice is idempotent, not a second row.
  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("job_applications")
}

/// "Not for this candidate" — one per (profile, job).
///
/// Deliberately shaped exactly like JobApplication, because it is the same kind
/// of fact: a judgement a person made about a posting for one profile, which
/// the app cannot observe for itself and therefore must be able to undo.
///
/// PER PROFILE, not per user. The same posting is a fair fit for one candidate
/// and wrong for the next, so discarding it while looking at one profile must
/// not hide it from the others — the pairing is what carries the meaning.
model JobDiscard {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the record still reads once its job row is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  /// When it was dismissed. Separate from createdAt for the same reason
  /// `appliedAt` is: the judgement has its own date, the row has another.
  discardedAt DateTime @default(now()) @map("discarded_at")

  /// Which member of a shared profile dismissed it.
  discardedById Int  @map("discarded_by_id")
  discardedBy   User @relation("DiscardMarkedBy", fields: [discardedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One marker per pairing: discarding twice is idempotent, not a second row.
  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("job_discards")
}

/// One cover letter, tailored to one job posting for one profile.
///
/// Stored as TEXT, not as structured paragraphs, because the letter is a thing
/// the user edits and pastes into an email. The model returns paragraphs, the
/// service assembles the date, recipient block, salutation and sign-off around
/// them, and what lands here is the finished letter. Re-parsing edited prose
/// back into a structure would buy nothing and lose the user's wording.
///
/// `jobId` is NULLABLE with onDelete: SetNull and the posting's title/company
/// are denormalised, for the same reason `Resume` does it: the jobs table is
/// re-scraped and pruned routinely, and a maintenance delete must not destroy
/// something the user paid model tokens for and may already have sent.
///
/// Exactly one per (profile, job). Regenerating replaces the text in place;
/// there is no draft history, so nothing accumulates and there is never a
/// question of which version is current.
model CoverLetter {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the letter still makes sense once its job row is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  /// The finished letter, ready to paste. Includes the assembled date, so it
  /// is a record of what was written rather than something that silently
  /// re-dates itself a week later.
  body String @db.Text

  /// Claims the letter makes that the candidate record does not state. Json
  /// rather than a table: it is a short list read only alongside its letter.
  reviewNotes Json @map("review_notes")

  /// True once the user has edited the text by hand. Regenerating then needs a
  /// confirmation, or a hand-tuned letter is overwritten by one click.
  edited Boolean @default(false)

  /// Which model produced it, so a later prompt change can find stale rows.
  model String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("cover_letters")
}

/// A model instruction, editable by super admins.
///
/// PROMPTS ARE DATA; THE CODE THAT SENDS THEM IS NOT. A row here replaces the
/// system prompt for one generator and nothing else — it cannot introduce a new
/// call, a new model or a new output schema, which is what makes a text field
/// an admin can edit safe to execute against.
///
/// Every key has a compiled-in default (see `PROMPT_DEFAULTS`), and a missing,
/// blank or deleted row falls back to it. Same reasoning as `FALLBACK_PRESET`:
/// an admin who empties this box gets the shipped behaviour back, not a
/// generator that silently produces nothing.
///
/// Editing a prompt invalidates the Anthropic cached prefix, so the first
/// generation after a change costs full price. That is a one-off, and worth
/// naming because it otherwise looks like a random cost spike.
model Prompt {
  key String @id @db.VarChar(64)

  /// The instruction text sent as the `system` block.
  content String @db.LongText

  /// Who last changed it, so an unexplained change in output has an owner.
  updatedById Int?  @map("updated_by_id")
  updatedBy   User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prompts")
}

/// A named, admin-curatable combination of the render parameters.
///
/// PRESETS ARE DATA; LAYOUTS ARE CODE. `layout` and `fontPair` are keys into
/// maps compiled into the app, never code themselves — storing renderable code
/// in a column would mean executing database content in the Node process, with
/// full access to env vars, the filesystem and the network.
///
/// Unknown values degrade to the defaults at render time, so a bad row makes a
/// resume look wrong rather than making the server crash or leak.
model TemplatePreset {
  id        Int     @id @default(autoincrement())
  key       String  @unique @db.VarChar(64)
  name      String  @db.VarChar(120)
  /// classic | modern | professional | creative
  category  String  @db.VarChar(32)
  /// Which compiled layout component renders it.
  layout    String  @db.VarChar(32)
  /// CSS colour for the accent, e.g. "#1f5f5b". Applied as a custom property —
  /// Tailwind v4 scans source statically, so a dynamic utility class would
  /// compile to nothing and silently ship an unstyled resume.
  accent    String  @default("#111111") @db.VarChar(16)
  /// Key into the compiled font-pair map.
  fontPair  String  @default("serif-classic") @db.VarChar(32)
  /// compact | regular | airy
  density   String  @default("regular") @db.VarChar(16)
  /// Measured, not claimed — and never shown to a user as a guarantee.
  atsSafe   Boolean @default(true) @map("ats_safe")
  sortOrder Int     @default(0) @map("sort_order")
  archived  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, sortOrder])
  @@map("template_presets")
}

/// One row per Anthropic API call: what it consumed, what it cost, and for whom.
///
/// COST IS PRICED ONCE, AT CALL TIME, AND STORED. The alternative — keeping only
/// token counts and multiplying by a live rate table on read — makes every
/// historical total change the day Anthropic changes a price, which defeats the
/// point of a spend log: reconciling against an invoice that was issued at the
/// old rate. `lib/pricing.ts` holds the rates; this table holds the outcome.
///
/// Written on the success path of each generator and never on the mock path
/// (AI_MOCK calls no model, so it spends nothing). A failure to write a row is
/// swallowed and logged, not raised: losing the accounting for a resume is bad,
/// losing the resume the user waited a minute for is worse.
model AiUsage {
  id Int @id @default(autoincrement())

  /// Which generator made the call: resume | cover_letter.
  feature String @db.VarChar(32)

  /// The exact model string sent, so a rate change can be traced to the rows it
  /// applies to.
  model String @db.VarChar(64)

  /// Who triggered it. SetNull rather than Cascade: deleting a user must not
  /// delete the money they spent — the invoice still arrives either way.
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Denormalised so a row can still name who spent it once the user is gone,
  /// same reasoning as the job title carried on `Resume`.
  userEmail String? @map("user_email") @db.VarChar(255)

  /// Context for the call. Plain ints with no foreign keys on purpose: jobs are
  /// re-scraped and pruned routinely, and a spend record must survive that
  /// without either blocking the delete or vanishing with it.
  profileId Int? @map("profile_id")
  jobId     Int? @map("job_id")

  /// Token counts exactly as the API reported them.
  ///
  /// `inputTokens` is the UNCACHED REMAINDER, not the prompt size — total tokens
  /// sent is the sum of the three input columns. Both generators cache the
  /// candidate block, so on the second application onward most of the prompt
  /// lands in `cacheReadTokens` and this column looks implausibly small.
  inputTokens      Int @default(0) @map("input_tokens")
  cacheWriteTokens Int @default(0) @map("cache_write_tokens")
  cacheReadTokens  Int @default(0) @map("cache_read_tokens")
  outputTokens     Int @default(0) @map("output_tokens")

  /// Cost in MILLIONTHS of a dollar.
  ///
  /// Integer micro-dollars, not DECIMAL and certainly not a float: a thousand
  /// cached input tokens on Opus cost $0.0005, which rounds away entirely in
  /// cents, and float addition makes a month's total depend on summation order.
  costMicroUsd Int @default(0) @map("cost_micro_usd")

  /// The markup in force WHEN THIS CALL RAN, in basis points of the vendor's
  /// list price: 10000 is list, 12000 is 1.2x.
  ///
  /// Stored per row, not looked up at read time, for the same reason the rate
  /// itself is baked into `costMicroUsd` — a super admin changing the markup
  /// must not silently rewrite what last month cost. It also makes the
  /// historical backfill idempotent: a row already carrying a markup is a row
  /// the script has done, so re-running it cannot double-charge.
  multiplierBp Int @default(10000) @map("multiplier_bp")

  /// False when the model had no rate in the table, so `costMicroUsd` is 0 and
  /// the dashboard reports the gap instead of quietly under-stating the bill.
  priced Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  /// The dashboard reads one date range at a time; this is the whole query.
  @@index([createdAt])
  @@index([userId])
  @@map("ai_usage")
}

/// What this deployment charges for one provider's calls, over list price.
///
/// One row per provider, edited by a super admin. Absent row means "list
/// price" — the app must keep pricing calls when this table is empty, so a
/// missing row is a default and never an error.
model AiProviderRate {
  /// 'claude' | 'openai'. A plain string rather than an enum: providers are
  /// added in code, and an enum would make every new one a schema migration.
  provider String @id @db.VarChar(16)

  /// Markup in BASIS POINTS of list price. 10000 = list, 12000 = 1.2x, 20000 = 2x.
  ///
  /// An integer for exactly the reason `costMicroUsd` is one: 1.2 is not
  /// representable in binary floating point, and a markup that drifts in the
  /// last decimal place makes two runs of the same report disagree.
  multiplierBp Int @default(10000) @map("multiplier_bp")

  /// Set the first time the historical backfill runs for this provider. The
  /// script refuses to touch a provider that already has one, which is what
  /// stops a second run from applying the markup on top of itself.
  backfilledAt DateTime? @map("backfilled_at")

  /// Who last changed it. Denormalised to an email rather than a foreign key,
  /// same reasoning as `AiUsage.userEmail`: the audit trail has to survive the
  /// account being deleted.
  updatedByEmail String? @map("updated_by_email") @db.VarChar(255)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_rates")
}

/// An interview stage badge — "Intro", "Live Coding", "Culture Fit"…
///
/// A TABLE, NOT AN ENUM. Every company assembles its own loop and invents its
/// own names for the rounds, so the list has to be editable by a super admin
/// without a migration and a redeploy. That is the whole reason this is not
/// `enum InterviewStage`.
///
/// `archived` rather than deleted, for the same reason `TemplatePreset` carries
/// it: steps point at these rows, and a badge that vanished mid-process would
/// either block the delete or leave a step wearing nothing. The service deletes
/// only a type no step has ever used, and archives every other one.
model InterviewStageType {
  id   Int    @id @default(autoincrement())
  key  String @unique @db.VarChar(64)
  name String @db.VarChar(80)

  /// CSS colour for the badge, e.g. "#6c5cff". Applied as an inline style, not
  /// a utility class: Tailwind v4 scans source statically, so a composed
  /// `bg-${color}-500` compiles to no CSS at all — silently, with no build
  /// error. Same trap `TemplatePreset.accent` documents.
  color String @default("#6c5cff") @db.VarChar(16)

  sortOrder Int     @default(0) @map("sort_order")
  archived  Boolean @default(false)

  steps InterviewStepStage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([archived, sortOrder])
  @@map("interview_stage_types")
}

/// One interview process — everything that happens after a job says yes.
///
/// Keyed on (profile, job) like `JobApplication` and `Resume`, and for the same
/// reason: two bidders working different profiles run different processes, and
/// a shared profile's whole team has to see the same timeline.
///
/// DELIBERATELY NOT A FOREIGN KEY TO `job_applications`. The UI only offers to
/// open a timeline on a job already marked applied, and `interviewService.open`
/// enforces that — but as a GUARD AT CREATION, not as a structural dependency.
/// An FK would mean one mis-click on "undo applied" cascades away an entire
/// interview history; instead `applicationService.unmark` refuses while a
/// timeline exists and says why.
///
/// `jobId` nullable with onDelete: SetNull and the title/company denormalised,
/// exactly as `Resume` and `JobApplication` do it: jobs are re-scraped and
/// pruned routinely, and this is hand-entered history a maintenance delete must
/// not take with it.
model Interview {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the timeline still names its employer once the job is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  status InterviewStatus @default(active)

  /// Bumped on every step and panel write. Drives the "no movement in three
  /// weeks — probably ghosted" flag, which is a real and common outcome that
  /// no employer will ever tell you about explicitly.
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  /// Which member of a shared profile opened it, same as `JobApplication`.
  openedById Int  @map("opened_by_id")
  openedBy   User @relation("InterviewOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)

  steps InterviewStep[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, jobId])
  @@index([jobId])
  @@index([status, lastActivityAt])
  @@map("interviews")
}

enum InterviewStatus {
  active
  offer
  accepted
  rejected
  withdrawn
  ghosted
  on_hold
}

/// One node on the timeline: a stage of the process.
///
/// A step wears one or more badges (`stages`) and holds one or more cards
/// (`panels`). Two badges on one step is not a corner case — "tech + live
/// coding in the same 90 minutes" is how most companies actually schedule it,
/// and forcing that into two steps would invent a gap that never happened.
///
/// There is NO date column. The marker on the rail is derived from the earliest
/// `scheduledAt` among this step's panels. Every panel field is optional, so a
/// step may legitimately have no date at all — and showing `createdAt` there
/// instead would put a confident, wrong date on the timeline.
model InterviewStep {
  id          Int       @id @default(autoincrement())
  interviewId Int       @map("interview_id")
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  title  String?    @db.VarChar(255)
  result StepResult @default(pending)

  /// Contiguous from 0, renumbered across siblings in one transaction on every
  /// insert. Gap numbering would avoid the rewrite, but a timeline is five to
  /// ten steps — the rewrite is free at that size, and contiguous ordering
  /// never runs out of room between two neighbours the way gaps eventually do.
  sortOrder Int @map("sort_order")

  stages InterviewStepStage[]
  panels InterviewPanel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([interviewId, sortOrder])
  @@map("interview_steps")
}

enum StepResult {
  pending
  passed
  failed
  cancelled
}

/// Which badges a step wears. A plain join table, ordered so the badges render
/// in the order they were attached rather than by id.
model InterviewStepStage {
  id Int @id @default(autoincrement())

  stepId Int           @map("step_id")
  step   InterviewStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  stageTypeId Int                @map("stage_type_id")
  stageType   InterviewStageType @relation(fields: [stageTypeId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0) @map("sort_order")

  /// A badge is on a step or it is not; attaching twice is not two badges.
  @@unique([stepId, stageTypeId])
  @@index([stageTypeId])
  @@map("interview_step_stages")
}

/// One card inside a step — a single sitting, or a note about one.
///
/// EVERY FIELD IS OPTIONAL, by design. A panel gets created the moment an email
/// arrives, when all you know is "they want to talk next week"; the link, the
/// time and the notes land later. A required field here would mean inventing
/// data to get past a form, which is worse than an empty card.
model InterviewPanel {
  id     Int           @id @default(autoincrement())
  stepId Int           @map("step_id")
  step   InterviewStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  title      String? @db.VarChar(255)
  note       String? @db.Text
  meetingUrl String? @map("meeting_url") @db.VarChar(2048)

  /// The instant, in UTC. Paired with `timezone` below and useless without it.
  scheduledAt DateTime? @map("scheduled_at")

  /// The IANA zone the invitation was written in ("America/New_York").
  ///
  /// STORED, NOT DERIVED. `scheduledAt` alone pins the instant, which is enough
  /// to sort by and to alarm on, but it cannot reproduce the sentence the
  /// recruiter actually wrote. Rendering "2:00 PM EST" back as "7:00 PM" and
  /// nothing else is how a candidate joins an hour late while believing the
  /// dashboard — so both readings are kept and both are shown.
  timezone String? @db.VarChar(64)

  durationMin Int? @map("duration_min")

  /// Contiguous from 0 within the step; see `InterviewStep.sortOrder`.
  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stepId, sortOrder])
  /// The cross-process "next 7 days" agenda reads this alone.
  @@index([scheduledAt])
  @@map("interview_panels")
}

/// One question a user asked the model about one posting, with its answer.
///
/// A LOG, NOT A CONVERSATION. Each row is a self-contained question answered
/// against the candidate record, the posting, and whatever documents existed at
/// the time — earlier answers are not fed back in. That keeps every row
/// re-readable on its own months later, and keeps the cost of a question flat
/// instead of growing with the length of the thread.
///
/// Keyed to a PROFILE, like `Resume` and `JobApplication`: the questions worth
/// asking about a posting depend on whose history is being matched against it,
/// and a shared profile's team should see the same log rather than each keeping
/// a private one.
model JobAiQuery {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the log still names its posting once the job row is gone,
  /// exactly as `Resume` and `CoverLetter` do it.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  question String @db.Text
  answer   String @db.LongText

  /// Which model wrote it, so a later prompt or model change can find stale rows.
  model String @db.VarChar(64)

  /// Which of the three context documents actually existed and were sent:
  /// `{ profile, resume, coverLetter }`.
  ///
  /// Stored because it changes how the answer should be read. The same question
  /// answered before a resume was generated and after it are different answers,
  /// and without this the log gives no way to tell which one you are looking at.
  context Json

  /// Which member of a shared profile asked, same reasoning as `JobApplication`.
  askedById Int  @map("asked_by_id")
  askedBy   User @relation("AiQueryAskedBy", fields: [askedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  /// The log reads one pairing newest-first; this is the whole query.
  @@index([profileId, jobId, createdAt])
  @@index([jobId])
  @@map("job_ai_queries")
}
