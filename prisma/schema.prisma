generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A single job posting scraped from a job site.
model Job {
  id          Int       @id @default(autoincrement())
  site        JobSite
  siteJobId   String    @map("site_job_id") @db.VarChar(191)
  title       String    @db.VarChar(512)
  description String    @db.LongText
  jobUrl      String    @map("job_url") @db.VarChar(1024)
  applyUrl    String?   @map("apply_url") @db.VarChar(2048)
  company     String?   @db.VarChar(255)
  companyUrl  String?   @map("company_url") @db.VarChar(1024)
  jobType     String?   @map("job_type") @db.VarChar(64)
  remote      Boolean   @default(false)
  location    String?   @db.VarChar(255)
  salary      String?   @db.VarChar(255)
  postedAt    DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resumes Resume[]

  @@unique([site, siteJobId], name: "site_siteJobId")
  @@index([site])
  @@map("jobs")
}

enum JobSite {
  indeed
  glassdoor
  jobright
  weworkremotely
  himalayas
  findmyremote
  jobicy
  themuse
}

/// The scrapers' staging table. Structurally a copy of `jobs`, written by
/// job-seeking/scraper/db.py when a scraper sets `table = "jobs_temp"` (today:
/// scraper/remoteok.py, "Promote to jobs once verified"). Modelled here ONLY so
/// `prisma migrate diff` reports zero drift and `prisma migrate dev` stays
/// usable — the backend never reads or writes it.
///
/// Index names are mapped to the ones the live table actually carries: it was
/// created as a copy of `jobs`, so they are `jobs_site_*`, not `jobs_temp_*`.
model JobTemp {
  id          Int         @id @default(autoincrement())
  site        JobSiteTemp
  siteJobId   String      @map("site_job_id") @db.VarChar(191)
  title       String      @db.VarChar(512)
  description String      @db.LongText
  jobUrl      String      @map("job_url") @db.VarChar(1024)
  applyUrl    String?     @map("apply_url") @db.VarChar(2048)
  company     String?     @db.VarChar(255)
  companyUrl  String?     @map("company_url") @db.VarChar(1024)
  jobType     String?     @map("job_type") @db.VarChar(64)
  remote      Boolean     @default(false)
  location    String?     @db.VarChar(255)
  salary      String?     @db.VarChar(255)
  postedAt    DateTime?   @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([site, siteJobId], map: "jobs_site_site_job_id_key")
  @@index([site], map: "jobs_site_idx")
  @@map("jobs_temp")
}

/// Same as JobSite plus `remoteok`, which is staged in jobs_temp and is NOT yet
/// a legal value in the `jobs` enum. Promoting RemoteOK to `jobs` (flipping
/// `table` in scraper/remoteok.py) therefore needs its own migration adding
/// `remoteok` to JobSite first, or every insert fails.
enum JobSiteTemp {
  indeed
  glassdoor
  jobright
  weworkremotely
  remoteok
  himalayas
  findmyremote
  jobicy
  themuse
}

/// One scraper run — logged by the Python scrapers so super-admins can see when
/// each site last scraped, how long it took, and how many jobs it found.
model ScrapeRun {
  id         Int       @id @default(autoincrement())
  site       String    @db.VarChar(64) // indeed | glassdoor | jobright | weworkremotely | all
  status     String    @default("running") @db.VarChar(20) // running | success | failed
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  inserted   Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  skipped    Int       @default(0)
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@map("scrape_runs")
}

/// Scraper configuration, editable by super-admins (search/filter URLs, enable
/// flags, limits…). The Python scrapers read these and override their .env
/// defaults at startup. Simple key/value so new settings need no migration.
model ScraperSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_settings")
}

/// Persisted browser session cookies per site (google/indeed/glassdoor/…),
/// replacing the local sessions/*.json files so sessions live in the DB.
model ScraperSession {
  site      String   @id @db.VarChar(64)
  cookies   String   @db.LongText // JSON array of cookies
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_sessions")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(guest)
  createdAt    DateTime @default(now()) @map("created_at")

  profiles Profile[]

  /// Invitations addressed to this user (profiles others let them use).
  profileInvitations ProfileInvitation[] @relation("InvitationInvitee")
  /// Invitations this user sent out.
  sentInvitations    ProfileInvitation[] @relation("InvitationInviter")

  @@map("users")
}

enum Role {
  super_admin
  admin
  bidder
  guest
}

/// A word to emphasize in job descriptions (managed by admins). The unique
/// constraint is case-insensitive via the utf8mb4_unicode_ci collation.
model Keyword {
  id        Int      @id @default(autoincrement())
  word      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keywords")
}

/// A candidate/bidding profile, owned by an admin. Holds personal info plus
/// repeatable work experience and education entries.
///
/// Two kinds of user reach a profile: its OWNER, who may edit and delete it,
/// and anyone holding an accepted `ProfileInvitation`, who may only read it and
/// generate resumes from it. Every query that serves a profile has to pick one
/// of those two scopes deliberately — see `ownedProfileWhere` /
/// `usableProfileWhere` in profile.service.ts.
model Profile {
  id      Int  @id @default(autoincrement())
  ownerId Int  @map("owner_id")
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  email     String? @db.VarChar(255)
  firstName String? @map("first_name") @db.VarChar(120)
  lastName  String? @map("last_name") @db.VarChar(120)
  phone     String? @db.VarChar(60)
  linkedin  String? @db.VarChar(512)
  location  String? @db.VarChar(255)

  /// Which template preset this profile's resumes render with. A plain key,
  /// not a relation: an archived or renamed preset must degrade to the default
  /// rather than break every resume that referenced it.
  defaultTemplateKey String? @map("default_template_key") @db.VarChar(64)

  workExperiences WorkExperience[]
  educations      Education[]
  resumes         Resume[]
  invitations     ProfileInvitation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("profiles")
}

/// An invitation from a profile's owner letting another user USE that profile:
/// see it on their own Profiles page and generate resumes from it, without ever
/// being able to edit its contents.
///
/// The invitation is a request, not a grant — access starts only once the
/// invitee sets it to `accepted`. Keeping `declined` as a stored state rather
/// than deleting the row is what lets the owner see the answer instead of
/// watching an invitation silently vanish and re-sending it forever.
model ProfileInvitation {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Who was invited.
  userId Int  @map("user_id")
  user   User @relation("InvitationInvitee", fields: [userId], references: [id], onDelete: Cascade)

  /// Who sent it. Normally the profile's owner, but recorded separately so the
  /// trail survives a future ownership transfer.
  invitedById Int  @map("invited_by_id")
  invitedBy   User @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  status InvitationStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  /// One invitation per (profile, user): re-inviting reopens the existing row
  /// rather than stacking duplicates the owner would have to reconcile.
  @@unique([profileId, userId])
  @@index([userId, status])
  @@map("profile_invitations")
}

enum InvitationStatus {
  pending
  accepted
  declined
}

/// One work-experience entry on a profile. `endDate` null = "Present".
/// Dates are month-granularity (stored as the 1st of the month, no timezone).
model WorkExperience {
  id        Int     @id @default(autoincrement())
  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company   String?   @db.VarChar(255)
  location  String?   @db.VarChar(255)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  sortOrder Int       @default(0) @map("sort_order")

  @@index([profileId])
  @@map("work_experiences")
}

/// One education entry on a profile. `endDate` null = "Present".
model Education {
  id        Int     @id @default(autoincrement())
  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  university String?   @db.VarChar(255)
  location   String?   @db.VarChar(255)
  degree     String?   @db.VarChar(255)
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  sortOrder  Int       @default(0) @map("sort_order")

  @@index([profileId])
  @@map("educations")
}

/// One AI-generated resume, tailored to one job posting for one profile.
///
/// `jobId` is NULLABLE with onDelete: SetNull, and the posting's title/company
/// are denormalised onto the row. That combination is deliberate:
///   - Cascade would let a routine job prune silently destroy work the user
///     paid model tokens for and may have already sent to an employer.
///   - Restrict would make `DELETE FROM jobs WHERE site='themuse'` fail, which
///     is exactly the re-scrape flow this project uses.
/// SetNull keeps deletes cheap AND keeps the resume readable afterwards, at the
/// cost of two duplicated columns.
///
/// Exactly one resume per (profile, job). Regenerating replaces the text in
/// place; there is no draft history, so nothing accumulates and there is never
/// a question of which version is current.
model Resume {
  id Int @id @default(autoincrement())

  profileId Int     @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  jobId Int? @map("job_id")
  job   Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Denormalised so the resume still makes sense once its job row is gone.
  jobTitle   String  @map("job_title") @db.VarChar(512)
  jobCompany String? @map("job_company") @db.VarChar(255)

  /// The generated document, shaped by `tailoredResumeSchema`. Json rather than
  /// columns because the shape is still settling and nothing queries into it.
  data        Json
  templateKey String @default("classic-ats") @map("template_key") @db.VarChar(64)
  /// Which model produced it, so a later prompt change can find stale rows.
  model       String @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([profileId, jobId])
  @@index([jobId])
  @@map("resumes")
}

/// A named, admin-curatable combination of the render parameters.
///
/// PRESETS ARE DATA; LAYOUTS ARE CODE. `layout` and `fontPair` are keys into
/// maps compiled into the app, never code themselves — storing renderable code
/// in a column would mean executing database content in the Node process, with
/// full access to env vars, the filesystem and the network.
///
/// Unknown values degrade to the defaults at render time, so a bad row makes a
/// resume look wrong rather than making the server crash or leak.
model TemplatePreset {
  id        Int     @id @default(autoincrement())
  key       String  @unique @db.VarChar(64)
  name      String  @db.VarChar(120)
  /// classic | modern | professional | creative
  category  String  @db.VarChar(32)
  /// Which compiled layout component renders it.
  layout    String  @db.VarChar(32)
  /// CSS colour for the accent, e.g. "#1f5f5b". Applied as a custom property —
  /// Tailwind v4 scans source statically, so a dynamic utility class would
  /// compile to nothing and silently ship an unstyled resume.
  accent    String  @default("#111111") @db.VarChar(16)
  /// Key into the compiled font-pair map.
  fontPair  String  @default("serif-classic") @db.VarChar(32)
  /// compact | regular | airy
  density   String  @default("regular") @db.VarChar(16)
  /// Measured, not claimed — and never shown to a user as a guarantee.
  atsSafe   Boolean @default(true) @map("ats_safe")
  sortOrder Int     @default(0) @map("sort_order")
  archived  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category, sortOrder])
  @@map("template_presets")
}
