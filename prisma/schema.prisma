generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A single job posting scraped from a job site.
model Job {
  id          Int      @id @default(autoincrement())
  site        JobSite
  siteJobId   String   @map("site_job_id") @db.VarChar(191)
  title       String   @db.VarChar(512)
  description String   @db.LongText
  jobUrl      String   @map("job_url") @db.VarChar(1024)
  applyUrl    String?  @map("apply_url") @db.VarChar(2048)
  company     String?  @db.VarChar(255)
  companyUrl  String?  @map("company_url") @db.VarChar(1024)
  jobType     String?  @map("job_type") @db.VarChar(64)
  remote      Boolean  @default(false)
  location    String?  @db.VarChar(255)
  salary      String?  @db.VarChar(255)
  postedAt    DateTime? @map("posted_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([site, siteJobId], name: "site_siteJobId")
  @@index([site])
  @@map("jobs")
}

enum JobSite {
  indeed
  glassdoor
  jobright
  weworkremotely
  himalayas
  findmyremote
}

/// One scraper run — logged by the Python scrapers so super-admins can see when
/// each site last scraped, how long it took, and how many jobs it found.
model ScrapeRun {
  id         Int       @id @default(autoincrement())
  site       String    @db.VarChar(64) // indeed | glassdoor | jobright | weworkremotely | all
  status     String    @default("running") @db.VarChar(20) // running | success | failed
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  inserted   Int       @default(0)
  updated    Int       @default(0)
  unchanged  Int       @default(0)
  skipped    Int       @default(0)
  error      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@map("scrape_runs")
}

/// Scraper configuration, editable by super-admins (search/filter URLs, enable
/// flags, limits…). The Python scrapers read these and override their .env
/// defaults at startup. Simple key/value so new settings need no migration.
model ScraperSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_settings")
}

/// Persisted browser session cookies per site (google/indeed/glassdoor/…),
/// replacing the local sessions/*.json files so sessions live in the DB.
model ScraperSession {
  site      String   @id @db.VarChar(64)
  cookies   String   @db.LongText // JSON array of cookies
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scraper_sessions")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(guest)
  createdAt    DateTime @default(now()) @map("created_at")

  profiles     Profile[]

  @@map("users")
}

enum Role {
  super_admin
  admin
  bidder
  guest
}

/// A word to emphasize in job descriptions (managed by admins). The unique
/// constraint is case-insensitive via the utf8mb4_unicode_ci collation.
model Keyword {
  id        Int      @id @default(autoincrement())
  word      String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keywords")
}

/// A candidate/bidding profile, owned by an admin. Holds personal info plus
/// repeatable work experience and education entries.
model Profile {
  id        Int      @id @default(autoincrement())
  ownerId   Int      @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  email     String?  @db.VarChar(255)
  firstName String?  @map("first_name") @db.VarChar(120)
  lastName  String?  @map("last_name") @db.VarChar(120)
  phone     String?  @db.VarChar(60)
  linkedin  String?  @db.VarChar(512)
  location  String?  @db.VarChar(255)

  workExperiences WorkExperience[]
  educations      Education[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("profiles")
}

/// One work-experience entry on a profile. `endDate` null = "Present".
/// Dates are month-granularity (stored as the 1st of the month, no timezone).
model WorkExperience {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company   String?  @db.VarChar(255)
  location  String?  @db.VarChar(255)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  sortOrder Int      @default(0) @map("sort_order")

  @@index([profileId])
  @@map("work_experiences")
}

/// One education entry on a profile. `endDate` null = "Present".
model Education {
  id         Int      @id @default(autoincrement())
  profileId  Int      @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  university String?  @db.VarChar(255)
  location   String?  @db.VarChar(255)
  degree     String?  @db.VarChar(255)
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  sortOrder  Int      @default(0) @map("sort_order")

  @@index([profileId])
  @@map("educations")
}
