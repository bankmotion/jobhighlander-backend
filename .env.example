# Connection string for the MySQL/MariaDB instance Prisma manages.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/jobhighlander"

PORT=4000
NODE_ENV=development

CORS_ORIGIN="http://localhost:3000"

# Auth — first user to register becomes super_admin (auto-approved)
AUTH_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"

# AI providers — server-side only, never exposed to the browser.
#
# Set AT LEAST ONE. The generators (tailored resume + cover letter, and Ask AI
# about a job) have no offline fallback, so with neither key they return 503.
# Set both and the app offers a choice at the point of generating; set one and
# the picker shows the other as "not configured" rather than letting a user
# pick something that cannot run.
#
# Each side runs its vendor's CHEAPEST current model — claude-haiku-4-5 at
# $1/$5 per MTok, gpt-5.6-luna at $0.20/$1.20. See backend/src/lib/ai.ts.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
