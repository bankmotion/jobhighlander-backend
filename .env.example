# Connection string for the MySQL/MariaDB instance Prisma manages.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/jobhighlander"

PORT=4000
NODE_ENV=development

CORS_ORIGIN="http://localhost:3000"

# Auth — first user to register becomes super_admin (auto-approved)
AUTH_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Anthropic / Claude — server-side only, never exposed to the browser.
# Required: the resume and cover letter generators are the app's only AI calls
# and there is no offline fallback, so without this they return 503.
ANTHROPIC_API_KEY=""
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OpenAI API key (optional)
OPENAI_API_KEY=
